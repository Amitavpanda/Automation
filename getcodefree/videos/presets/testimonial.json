{
  "name": "testimonial",
  "description": "30-45s testimonial: lower-third name/title, subtle transitions, trust-building",
  "canvas": { "aspect_ratio": "9:16" },
  "tracks": {
    "video": [
      { "type": "clip", "duration_range": "8-12s", "transition": "crossfade", "transition_duration": 0.5 }
