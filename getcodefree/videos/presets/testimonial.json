      { "role": "quote", "style": "italic", "color": "#ffffff", "font_size": 24, "position": "center" },
      { "role": "caption", "style": "sentence", "color": "#ffffff", "font_size": 20, "position": "bottom-center" },
      { "role": "cta", "start": -5, "end": 0, "text": "Work with us → @AmitavPanda99", "style": "regular", "color": "#ffffff", "bg": "#19d3c5", "position": "center", "font_size": 24 }
    ],
    "audio": [
      { "role": "music", "volume": 0.2, "duck_under_voice": true, "mood": "calm" }
    ]
  },
  "lint_rules": { "max_cps": 18, "safe_area": true, "speed_consistency": true }
}